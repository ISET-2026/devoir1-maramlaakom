{% extends 'base.html.twig' %}

{% block title %}Liste des Projets{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0"> Liste des Projets</h1>
        <a href="{{ path('app_projet_new') }}" class="btn btn-primary">+ Nouveau Projet</a>
    </div>
    <form method="get" action="{{ path('app_projet_index') }}" 
    class="row g-3 mb-4 border p-3 bg-light shadow-sm rounded">
        <div class="col-md-5">
            <input type="text" name="titre" placeholder="Rechercher par titre..." 
                   class="form-control" value="{{ app.request.query.get('titre') }}">
        </div>
        <div class="col-md-4">
            <select name="statut" class="form-select">
                <option value="">-- Filtrer par Statut --</option>
                <option value="En préparation" {{ app.request.query.get('statut') == 'En préparation' ? 'selected' : '' }}>En préparation</option>
                <option value="En cours" {{ app.request.query.get('statut') == 'En cours' ? 'selected' : '' }}>En cours</option>
                <option value="Terminé" {{ app.request.query.get('statut') == 'Terminé' ? 'selected' : '' }}>Terminé</option>
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary w-100"> Chercher</button>
        </div>
    </form>

    {% if projets is empty %}
        <div class="alert alert-info">
            Aucun projet trouvé. <a href="{{ path('app_projet_new') }}" class="alert-link">Créer un projet maintenant.</a>
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-bordered table-hover shadow-sm">
                <thead class= "card-header text-center"> 
                    <tr>
                        <th>ID</th>
                        <th>Titre</th>
                        <th>Description</th>
                        <th>Période</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for projet in projets %}
                    <tr>
                        <td class="text-center fw-bold">{{ projet.id }}</td>
                        <td>{{ projet.titre }}</td>
                        <td>{{ projet.description|slice(0, 50) }}...</td>
                        <td class="small">
                            <strong>Du:</strong> {{ projet.dateDebut ? projet.dateDebut|date('d/m/Y') : '-' }}<br>
                            <strong>Au:</strong> {{ projet.dateFin ? projet.dateFin|date('d/m/Y') : '-' }}
                        </td>
                        <td class="text-center">
                            {% if projet.statut == 'En préparation' %}
                                <span class="badge bg-secondary"> En preparation</span>
                            {% elseif projet.statut == 'En cours' %}
                                <span class="badge bg-primary"> En cours</span>
                            {% elseif projet.statut == 'Terminé' %}
                                <span class="badge bg-success"> Terminé</span>
                            {% else %}
                                <span class="badge bg-light text-dark">{{ projet.statut }}</span>
                            {% endif %}
                        </td>
                        <td class="text-center">
                            <div class="btn-group btn-group-sm">
                                <a href="{{ path('app_projet_show', {'id': projet.id}) }}" class="btn btn-outline-info" title="detail">detail</a>
                                <a href="{{ path('app_projet_edit', {'id': projet.id}) }}" class="btn btn-outline-warning" title="Modifier">modifier</a>
                                {{ include('projet/_delete_form.html.twig') }}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        
        <p class="mt-3 text-muted small">
            {{ projets|length }} projet(s) trouvé(s)
        </p>
    {% endif %}
{% endblock %}