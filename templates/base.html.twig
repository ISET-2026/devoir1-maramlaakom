<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Gestion de Projets Académiques{% endblock %}</title>
        
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        
        <style>
            body { background-color: rgb(205, 230, 255); }
            .navbar-brand { font-weight: bold; color: #a3c5f8 !important; }
            .main-container { min-height: 80vh; }
        </style>

        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        <nav class="navbar navbar-expand-lg mb-4 shadow">
            <div class="container">
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_etudiant_index') }}"> Étudiants</a>
                        </li>
                         <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_projet_index') }}"> index projet </a>
                        </li>

                        </ul>
                </div>
            </div>
        </nav>

        <div class="container main-container bg-white p-4 shadow-sm rounded">
            
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'success' ? 'success' : 'danger' }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                    
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </div>

        <footer class="text-center py-4 text-muted mt-5">
            &copy; {{ "now"|date("Y") }} 
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        
        {% block javascripts %}{% endblock %}
    </body>
</html>